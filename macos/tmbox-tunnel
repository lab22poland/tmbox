#!/bin/zsh
#
# The forward that carries SMB from this Mac to the appliance.
#
# Installed at /Library/Application Support/tmbox/tmbox-tunnel and run by the
# LaunchDaemon pl.lab22.tmbox.tunnel. Deliberately tiny: launchd owns the
# restarting, so this does two things and then gets out of the way.
#
#   1. make sure the loopback alias exists
#   2. exec ssh
#
# **Why an alias and not 127.0.0.1.** The macOS SMB client treats 127.0.0.1 as
# "this Mac" and will not mount from itself - measured as a connection that
# times out rather than one that is refused. A second loopback address is a
# different server as far as the client is concerned, and mounts normally.
#
# **Why port 445 and not a high port.** Both mount_smbfs and backupd honour a
# port in an smb:// URL - measured in the Tart guest on macOS 26.6 - but
# `tmutil setdestination` does not: it validates the destination by opening its
# own session, and that session ignores the port and fails with authentication
# error 80. 127.0.0.2:4445 fails, 127.0.0.2:445 succeeds, with everything else
# held constant. So the forward has to land on a privileged port, which is the
# whole reason this runs as a root daemon with an alias rather than as an
# ordinary user's agent.
#
# **Why exec.** launchd supervises what this process becomes. Without exec, ssh
# would be the child of a shell that launchd watches instead, KeepAlive would be
# watching the shell rather than the connection, and a dead tunnel would look
# healthy.

emulate -L zsh
setopt no_unset pipe_fail

typeset -g SELF="${0:t}"

typeset -g T_HOST=""
typeset -g T_USER="tmtunnel"
typeset -g T_KEY=""
typeset -g T_KNOWN=""
typeset -g T_BIND="127.0.0.2"
typeset -g T_LOCAL_PORT="445"
typeset -g T_REMOTE="127.0.0.1:445"

die() { print -u2 -- "${SELF}: $*"; exit 78 }   # EX_CONFIG

while (( $# > 0 )); do
  case "$1" in
    --host)        T_HOST="${2:-}"; shift ;;
    --user)        T_USER="${2:-}"; shift ;;
    --key)         T_KEY="${2:-}"; shift ;;
    --known-hosts) T_KNOWN="${2:-}"; shift ;;
    --bind)        T_BIND="${2:-}"; shift ;;
    --local-port)  T_LOCAL_PORT="${2:-}"; shift ;;
    --remote)      T_REMOTE="${2:-}"; shift ;;
    *)             die "unknown option: $1" ;;
  esac
  shift
done

[[ -n "$T_HOST" ]] || die "--host is required"
[[ -n "$T_KEY"  ]] || die "--key is required"
[[ -r "$T_KEY"  ]] || die "cannot read the tunnel key: $T_KEY"
[[ -n "$T_KNOWN" ]] || T_KNOWN="${T_KEY:h}/known_hosts"

# The alias does not survive a reboot, so it is added here rather than assumed.
# Adding it needs root; a failure is fatal because ssh's bind would fail next
# anyway, and failing here says why.
if ! ifconfig lo0 2>/dev/null | grep -qE "inet ${T_BIND}\b"; then
  ifconfig lo0 alias "$T_BIND" up 2>/dev/null \
    || die "could not add the loopback alias ${T_BIND} (needs root)"
fi

# accept-new rather than no: the appliance's address is a Hetzner primary IP
# that has belonged to someone else before and will again. A changed host key
# must stop the tunnel, not be accepted silently.
#
# ExitOnForwardFailure is what makes a wedged tunnel visible. Without it ssh
# stays connected with no listener, every backup fails at the mount, and
# launchd goes on reporting the job as healthy.
#
# **The keepalive is deliberately slow: 30s x 10, so five minutes.** It was
# 15s x 3, chosen to fail fast, which is the wrong instinct for a link that
# spends hours saturated: on a 1.89 MB/s uplink the server's keepalive replies
# queue behind bulk data, and a 45-second window is not much margin. Five
# minutes still notices a genuinely dead link long before a person would, and
# a backup that runs for hours is not evidence of a fault.
#
# **This was first committed as the fix for a mid-backup disconnect, and that
# was wrong.** The backup failed again with the same error after the change:
#
#   Read from remote host: Operation timed out
#   client_loop: send disconnect: Broken pipe
#
# "Operation timed out" on a *read* is the kernel giving up on TCP
# retransmission, not ssh's ServerAlive expiring - they look alike in a log
# and are not the same fault. Isolated on 2026-09-19 by taking tmbox out of
# it entirely: a plain `dd | ssh cat` of 150 MB dies the same way from the
# Tart guest after ~90 seconds, and completes in 51 seconds from the host it
# runs on. The difference is the guest's vmnet NAT, so it is a property of the
# test environment and not of this code. Recorded here because the next person
# to see a mid-backup disconnect will reach for this setting first, and that is
# the wrong place to look.
exec /usr/bin/ssh \
  -N -T \
  -i "$T_KEY" \
  -o IdentitiesOnly=yes \
  -o IdentityAgent=none \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="\"${T_KNOWN}\"" \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ConnectTimeout=20 \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=10 \
  -o TCPKeepAlive=yes \
  -o LogLevel=ERROR \
  -L "${T_BIND}:${T_LOCAL_PORT}:${T_REMOTE}" \
  "${T_USER}@${T_HOST}"
